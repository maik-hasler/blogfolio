---
import Base from '../layouts/Base.astro';
import PixelLabel from '../components/ui/PixelLabel.astro';
import PixelButton from '../components/ui/PixelButton.astro';
import PistonBlock from '../components/ui/PistonBlock.astro';
---

<Base title="Chunk nicht geladen | Maik Hasler" description="Diese Seite gibt es nicht." headerTone="dark">
  <section class="blueprint grow text-cream">
    <div class="container-page grid items-center gap-12 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-32">
      <div class="flex flex-col items-start gap-6">
        <PixelLabel tone="bright">Fehler 404</PixelLabel>
        <h1 class="font-display text-display-xl font-bold uppercase display-shadow">Chunk nicht geladen</h1>
        <p class="max-w-lg text-lg text-cream-muted">
          Diese Koordinaten kennt die Welt nicht. Entweder ein Tippfehler, oder ich habe die Seite
          abgebaut.
        </p>
        <PixelButton href="/">Zurück zum Spawn</PixelButton>
      </div>
      <div class="mx-auto flex w-fit flex-col items-center lg:justify-self-end">
        <PistonBlock class="w-44 lg:w-64" headless />
        <PixelLabel tone="bright" class="mt-6">Piston · Kopf fehlt</PixelLabel>
        <p class="mt-2 font-mono italic text-cream-dim">~ Maik</p>
      </div>
    </div>
  </section>
</Base>
