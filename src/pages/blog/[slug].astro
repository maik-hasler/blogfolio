---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import ScrollTable from '../../components/ScrollTable.astro';
import { getPublishedPosts, postUrl, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const asNeighbor = (post: Post) => ({ title: post.data.title, url: postUrl(post) });

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Sorting is descending, so the array's predecessor is the newer post.
      newer: index > 0 ? asNeighbor(posts[index - 1]) : undefined,
      older: index < posts.length - 1 ? asNeighbor(posts[index + 1]) : undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} newer={newer} older={older} headings={headings}>
  <Content components={{ table: ScrollTable }} />
</BlogPost>
