---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => data.published)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const alsLink = (post: (typeof posts)[number]) => ({ title: post.data.title, url: `/blog/${post.id}/` });

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Sortierung ist absteigend: der Vorgänger im Array ist der neuere Beitrag.
      neuer: index > 0 ? alsLink(posts[index - 1]) : undefined,
      aelter: index < posts.length - 1 ? alsLink(posts[index + 1]) : undefined,
    },
  }));
}

const { post, neuer, aelter } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} neuer={neuer} aelter={aelter}>
  <Content />
</BlogPost>
