---
import Base from '../../layouts/Base.astro';
import PixelLabel from '../../components/ui/PixelLabel.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, postUrl } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Base
  title="Blog | Maik Hasler"
  description="Posts by Maik Hasler about .NET, software architecture, domain-driven design, and documentation."
>
  <section class="container-page py-14 lg:py-20">
    <PixelLabel tone="ink">Book and Quill</PixelLabel>
    <h1 class="font-display text-display-lg font-bold uppercase display-shadow-paper mt-4">Blog</h1>
    <p class="mt-4 max-w-xl text-ink-soft">
      I write down what I learn along the way. {posts.length} posts so far.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {posts.map((post) => (
        <PostCard
          url={postUrl(post)}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingMinutes={post.data.ttr}
          headingLevel="h2"
        />
      ))}
    </div>
  </section>
</Base>
