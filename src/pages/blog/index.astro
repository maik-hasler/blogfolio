---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, postUrl } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Base
  title="Blog | Maik Hasler"
  description="Posts by Maik Hasler about .NET, software architecture, domain-driven design, and documentation."
>
  <section class="container-page py-14 lg:py-20">
    <p class="eyebrow">Writing</p>
    <h1 class="blog-heading mt-3">Notes on software</h1>
    <p class="mt-4 max-w-xl text-ink-soft">{posts.length} posts on architecture, development, and the work around it.</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {posts.map((post) => (
        <PostCard
          url={postUrl(post)}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingMinutes={post.data.ttr}
          headingLevel="h2"
        />
      ))}
    </div>
  </section>
</Base>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .blog-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }
</style>
