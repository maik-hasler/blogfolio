---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PixelLabel from '../../components/ui/PixelLabel.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => data.published)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Blog | Maik Hasler"
  description="Beiträge von Maik Hasler über .NET, Softwarearchitektur, Domain-Driven Design und Dokumentation. Auf Englisch."
>
  <section class="container-page py-14 lg:py-20">
    <PixelLabel tone="ink">Buch &amp; Feder</PixelLabel>
    <h1 class="font-display text-display-lg font-bold uppercase display-shadow-paper mt-4">Blog</h1>
    <p class="mt-4 max-w-xl text-ink-soft">
      Was ich unterwegs lerne, schreibe ich auf. Auf Englisch, damit auch der Rest der Welt mitlesen kann.
      {posts.length} Beiträge bisher.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {posts.map((post) => (
        <PostCard
          url={`/blog/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          ttr={post.data.ttr}
          headingLevel="h2"
        />
      ))}
    </div>
  </section>
</Base>
