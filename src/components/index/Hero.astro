---
import { Image } from 'astro:assets';
import meImage from '../../assets/me.png';
import Mana from '../ui/Mana.astro';
import PixelButton from '../ui/PixelButton.astro';
---

<section class="blueprint text-cream" aria-labelledby="hero-title">
  <div class="container-page grid items-center gap-12 py-14 lg:grid-cols-[1fr_26rem] lg:gap-20 lg:py-20">
    <div class="max-w-xl">
      <p class="font-mono text-label font-semibold uppercase text-redstone-bright">Now on the battlefield</p>
      <h1 id="hero-title" class="font-display text-display-xl font-bold uppercase display-shadow mt-4">
        Maik <br />Hasler
      </h1>
      <p class="font-display text-display-md font-bold uppercase display-shadow mt-4 text-cream-muted">
        Architect. Trainer. <span class="text-redstone-bright">Examiner.</span>
      </p>
      <p class="mt-6 text-lg text-cream-muted">
        Instead of a boring bio, here's my card. I play a lot of Magic: The Gathering these days, and
        it turns out I fit the format: rules everywhere, a few broken combos, and an
        <em>amazing</em> mana curve. Go ahead, poke it.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <PixelButton href="/blog">Open the grimoire</PixelButton>
        <PixelButton href="https://www.linkedin.com/in/maik-hasler/" tone="paper" external>Contact</PixelButton>
      </div>
      <p class="mt-8 font-mono text-sm text-cream-dim">
        Tip: activate an ability, flip the card, or tap the power and toughness box.
      </p>
    </div>

    <div class="mtg-stage mx-auto w-full max-w-[24rem] lg:max-w-none">
      <div class="mtg-tilt" id="tilt">
        <div class="mtg-flip" id="flip">
          <article class="mtg-card mtg-face mtg-front" id="card" data-frame="gold" aria-label="Maik Hasler, trading card">
            <div class="mtg-frame">
              <div class="mtg-bar">
                <h2>Maik Hasler</h2>
                <span class="whitespace-nowrap"><Mana sym="2" /><Mana sym="U" /><Mana sym="R" /></span>
              </div>

              <div class="mtg-art">
                <Image src={meImage} alt="Maik Hasler wearing a cap and glasses, black-and-white photo" width={700} class="art-img" />
              </div>

              <div class="mtg-bar mtg-type">
                <span>Legendary Creature: Architect</span>
                <span class="mtg-setsym" aria-hidden="true"></span>
              </div>

              <div class="mtg-text">
                <p>
                  <button type="button" class="ability" id="ab-tap" aria-pressed="false">
                    <Mana sym="T" />: Add one architecture test.
                  </button>
                </p>
                <p>
                  <button type="button" class="ability" id="ab-focus" aria-pressed="false">
                    <Mana sym="1" /><Mana sym="R" />: Hyperfocus. +1/+0, forgets to eat.
                  </button>
                </p>
                <p>
                  <button type="button" class="ability" id="ab-exam">
                    <Mana sym="2" /><Mana sym="U" />: Exam season. Apprentices sweat.
                  </button>
                </p>
                <p class="mtg-flavor">“Why farm something for hours when a script can do it for me?”</p>
              </div>
            </div>

            <button type="button" class="mtg-pt" id="pt" aria-label="Power and toughness, click to toggle">
              <span id="pt-val">0/1</span>
            </button>
            <p class="mtg-legal" aria-hidden="true">
              <span>001/001 R · MH · EN<br />Illus. Maik Hasler</span>
              <span class="text-right">™ &amp; © Maik Hasler<br />Fan tribute</span>
            </p>
          </article>

          <div class="mtg-glare mtg-face" aria-hidden="true"></div>

          <div class="mtg-card mtg-face mtg-back" aria-hidden="true">
            <div class="back-inner">
              <span class="back-ring"><span>MH</span></span>
              <span class="back-name">Blogfolio</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-center gap-3">
        <button type="button" class="mtg-btn" id="btn-flip">Flip card</button>
        <button type="button" class="mtg-btn" id="btn-reset">Reset</button>
      </div>
      <p class="mt-4 min-h-[3.5rem] text-center font-serif italic text-cream-muted" id="stack" role="status" aria-live="polite">
        The stack is empty.
      </p>
    </div>
  </div>
</section>

<style>
  .mtg-stage {
    perspective: 1200px;
  }
  .mtg-tilt {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 150ms ease-out;
  }
  .mtg-tilt[data-idle] {
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .mtg-flip {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 700ms cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .mtg-flip.is-flipped {
    transform: rotateY(180deg);
  }
  .mtg-flip.is-tapped {
    transform: rotate(90deg) scale(0.72);
  }
  .mtg-flip.is-tapped.is-flipped {
    transform: rotate(90deg) rotateY(180deg) scale(0.72);
  }
  .mtg-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .mtg-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }
  .mtg-front.is-focused .mtg-frame {
    box-shadow: 0 0 0 1cqw #ff7d60, 0 0 10cqw 2cqw rgb(255 125 96 / 0.7);
  }

  .art-img {
    filter: grayscale(1) contrast(1.1) sepia(0.45) saturate(1.4);
    object-position: center 25%;
  }

  .mtg-front .mtg-text {
    font-size: 4cqw;
    line-height: 1.2;
    padding: 2.4cqw 3cqw;
  }
  .mtg-front .mtg-art {
    aspect-ratio: 16 / 10;
  }
  .ability {
    display: block;
    width: 100%;
    padding: 0.8cqw 1.2cqw;
    border-radius: 1.2cqw;
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms;
  }
  .ability:hover,
  .ability[aria-pressed='true'] {
    background-color: rgb(154 116 32 / 0.25);
  }
  .mtg-pt {
    cursor: pointer;
  }

  /* The glare sits above the card and shows only while the pointer moves over it. */
  .mtg-glare {
    position: absolute;
    inset: 0;
    border-radius: 4.8cqw;
    border-radius: 1.2rem;
    pointer-events: none;
    mix-blend-mode: color-dodge;
    opacity: var(--glare, 0);
    background:
      radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgb(255 255 255 / 0.5), transparent 45%),
      linear-gradient(115deg, transparent 20%, rgb(255 90 200 / 0.3) 35%, rgb(90 220 255 / 0.3) 50%, rgb(255 230 90 / 0.3) 65%, transparent 80%);
    transition: opacity 200ms;
  }

  .back-inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6cqw;
    border: 4cqw solid #0b0a0c;
    border-radius: 4.8cqw;
    background: repeating-conic-gradient(from 0deg at 50% 50%, #5a1e1a 0 10deg, #3a1210 10deg 20deg);
    box-shadow: inset 0 0 0 1cqw var(--color-gold), inset 0 0 0 2cqw #0c0a12;
  }
  .back-ring {
    display: grid;
    place-items: center;
    width: 40cqw;
    height: 40cqw;
    border-radius: 50%;
    border: 1.5cqw solid var(--color-gold);
    background: radial-gradient(circle, #8e2330, #2a0d1a);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14cqw;
    color: var(--color-gold);
  }
  .back-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 6cqw;
    color: var(--color-gold);
  }

  .mtg-btn {
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    transition: background-color 150ms, color 150ms;
  }
  .mtg-btn:hover {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .mtg-tilt {
      transform: none !important;
    }
  }
</style>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const tilt = $('tilt');
  const flip = $('flip');
  const card = $('card');
  const stack = $('stack');
  const pt = $('pt-val');
  const abTap = $<HTMLButtonElement>('ab-tap');
  const abFocus = $<HTMLButtonElement>('ab-focus');
  const abExam = $<HTMLButtonElement>('ab-exam');

  const say = (text: string) => (stack.textContent = text);
  const state = { tapped: false, focused: false, binary: true, exams: 0 };

  const renderPt = () => {
    const base = state.binary ? [0, 1] : [1, 0];
    pt.textContent = `${base[0] + (state.focused ? 1 : 0)}/${base[1]}`;
  };

  // Pointer tilt and holo glare, skipped for reduced motion and touch-less hover.
  const motionOk = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (motionOk) {
    tilt.addEventListener('pointermove', (e) => {
      const r = tilt.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      tilt.removeAttribute('data-idle');
      tilt.style.setProperty('--ry', `${(x - 0.5) * 18}deg`);
      tilt.style.setProperty('--rx', `${(0.5 - y) * 18}deg`);
      tilt.style.setProperty('--mx', `${x * 100}%`);
      tilt.style.setProperty('--my', `${y * 100}%`);
      tilt.style.setProperty('--glare', '0.55');
    });
    tilt.addEventListener('pointerleave', () => {
      tilt.setAttribute('data-idle', '');
      tilt.style.setProperty('--rx', '0deg');
      tilt.style.setProperty('--ry', '0deg');
      tilt.style.setProperty('--glare', '0');
    });
  }

  const setTapped = (on: boolean) => {
    state.tapped = on;
    flip.classList.toggle('is-tapped', on);
    abTap.setAttribute('aria-pressed', String(on));
  };
  const setFocused = (on: boolean) => {
    state.focused = on;
    card.classList.toggle('is-focused', on);
    abFocus.setAttribute('aria-pressed', String(on));
    renderPt();
  };

  abTap.addEventListener('click', () => {
    if (state.tapped) {
      setTapped(false);
      say('Maik untaps. It was a good night’s sleep. (Rare.)');
    } else {
      setTapped(true);
      say('Maik taps: one architecture test added. A dependency cycle quietly disappears.');
    }
  });

  abFocus.addEventListener('click', () => {
    if (state.focused) {
      setFocused(false);
      say('Hyperfocus ends. Maik remembers he has a body and goes to find food.');
    } else {
      setFocused(true);
      say('Hyperfocus resolves. Maik now has +1/+0 and has forgotten what “lunch” means.');
    }
  });

  const exams = [
    'Exam season: an apprentice sweats. Maik is just there to check the diagram.',
    'Exam season: a second-normal-form question lands. Two apprentices sweat.',
    'Exam season: “Explain the difference between association and aggregation.” The whole table sweats.',
    'Exam season: everyone passes. That was the real combo all along.',
  ];
  abExam.addEventListener('click', () => {
    say(exams[state.exams % exams.length]);
    state.exams += 1;
    card.animate(
      [{ transform: 'translateX(0)' }, { transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(0)' }],
      { duration: 250 },
    );
  });

  $('pt').addEventListener('click', () => {
    state.binary = !state.binary;
    renderPt();
    say(state.binary ? 'Power and toughness: 0/1. Off.' : 'Power and toughness: 1/0. On. Binary, as advertised.');
  });

  const toggleFlip = () => {
    const on = flip.classList.toggle('is-flipped');
    say(on ? 'You flipped the card. Nothing to see here, just a very nice pattern.' : 'Face up again.');
  };
  $('btn-flip').addEventListener('click', toggleFlip);

  $('btn-reset').addEventListener('click', () => {
    setTapped(false);
    setFocused(false);
    flip.classList.remove('is-flipped');
    state.binary = true;
    renderPt();
    say('The stack is empty.');
  });
</script>
