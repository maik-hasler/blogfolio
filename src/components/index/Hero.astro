---
import { Image } from 'astro:assets';
import meImage from '../../assets/me.png';
import Mana from '../ui/Mana.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-page hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Software architect · Trainer · IHK examiner</p>
      <h1 id="hero-title">Software is a people business.</h1>
      <p class="hero__intro">
        I’m Maik, a software architect at VRG GmbH in Oldenburg. I work on software architecture and
        technical strategy in PROVIA, train apprentices, and examine at IHK Oldenburg.
      </p>
      <div class="hero__links">
        <a class="text-link" href="#work">A little about my work <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="/blog">Read the blog <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero__location">Oldenburg, Germany</p>
    </div>

    <figure class="card-wrap">
      <article class="mtg-card" aria-label="A custom Magic card featuring Maik Hasler">
        <div class="mtg-frame">
          <div class="mtg-bar">
            <h2>Maik Hasler</h2>
            <span class="mana-cost"><Mana sym="2" /><Mana sym="U" /><Mana sym="R" /></span>
          </div>
          <div class="mtg-art">
            <Image src={meImage} alt="Maik Hasler wearing a cap and glasses" width={700} class="art-img" />
          </div>
          <div class="mtg-bar mtg-type">
            <span>Legendary Creature: Human Architect</span>
            <span class="set-symbol" aria-hidden="true">MH</span>
          </div>
          <div class="mtg-text">
            <p>
              Whenever a teammate asks “why?”, investigate. If the answer is “it depends,” create a
              1/1 curious human token.
            </p>
            <p class="mtg-flavor">
              “The human side of software matters more than ever.”
            </p>
          </div>
          <div class="mtg-bottom">
            <span>Custom card · Oldenburg</span>
            <span class="mtg-pt">2/3</span>
          </div>
        </div>
      </article>
      <figcaption>A personal card, not an official one.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    background: var(--color-page);
  }
  .hero__inner {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .hero__copy {
    max-width: 39rem;
  }
  .eyebrow,
  .hero__location {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .hero h1 {
    max-width: 10ch;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
    color: var(--color-ink);
  }
  .hero__intro {
    max-width: 35rem;
    margin-top: 1.6rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-muted);
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2rem;
  }
  .text-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .text-link:hover {
    color: var(--color-accent);
  }
  .hero__location {
    margin-top: 3rem;
  }
  .card-wrap {
    width: min(100%, 20rem);
    justify-self: center;
    transform: rotate(2deg);
  }
  .card-wrap figcaption {
    margin-top: 0.8rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-muted);
  }
  .mtg-card {
    container-type: inline-size;
    aspect-ratio: 63 / 88;
    padding: 3.4cqw;
    border: 1px solid #252218;
    border-radius: 4.3cqw;
    background: #22221d;
    box-shadow: 0 1.6rem 3rem -1.5rem rgb(24 27 26 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.3);
    color: #1b1a15;
    font-family: var(--font-serif);
  }
  .mtg-frame {
    display: flex;
    flex-direction: column;
    gap: 2.2cqw;
    height: 100%;
    padding: 2.2cqw;
    border: 1px solid rgb(0 0 0 / 0.6);
    border-radius: 3cqw;
    background: linear-gradient(145deg, #77724e, #484937 40%, #242b26);
    box-shadow: inset 0 0 0 1px rgb(218 202 142 / 0.55);
  }
  .mtg-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
    padding: 1.6cqw 2.8cqw;
    border: 1px solid #514c39;
    border-radius: 2cqw;
    background: linear-gradient(#f3ead1, #d6c9a5);
    box-shadow: inset 0 1px rgb(255 255 255 / 0.75), 0 1px 2px rgb(0 0 0 / 0.5);
    font-family: var(--font-display);
    font-size: 5.6cqw;
    font-weight: 700;
    line-height: 1.1;
  }
  .mtg-bar h2 {
    font-size: inherit;
  }
  .mana-cost {
    display: flex;
    white-space: nowrap;
  }
  .mtg-art {
    overflow: hidden;
    flex: none;
    aspect-ratio: 3 / 2;
    border: 1px solid #151510;
    box-shadow: 0 0 0 1px #b19d65;
  }
  .art-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: sepia(0.35) saturate(0.72);
  }
  .mtg-type {
    font-size: 3.9cqw;
  }
  .set-symbol {
    display: grid;
    flex: none;
    place-items: center;
    width: 5cqw;
    height: 5cqw;
    border: 1px solid #333126;
    border-radius: 50%;
    background: #b7a966;
    font: 700 2.2cqw var(--font-mono);
  }
  .mtg-text {
    flex: 1;
    padding: 3cqw;
    border: 1px solid #9a8b62;
    border-radius: 1cqw;
    background: linear-gradient(#f3ead5, #e1d5b8);
    font-size: 4.5cqw;
    line-height: 1.3;
  }
  .mtg-flavor {
    margin-top: 2.8cqw;
    padding-top: 2.3cqw;
    border-top: 1px solid rgb(46 42 32 / 0.35);
    font-style: italic;
  }
  .mtg-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    min-height: 5cqw;
    padding-inline: 1cqw;
    color: #eee8d7;
    font: 2.5cqw var(--font-mono);
  }
  .mtg-pt {
    padding: 0.5cqw 3cqw;
    border: 1px solid #514c39;
    border-radius: 1.3cqw;
    background: linear-gradient(#f3ead1, #d6c9a5);
    color: #171610;
    font: 700 5cqw var(--font-display);
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }
  @media (max-width: 899px) {
    .hero__copy {
      max-width: 44rem;
    }
    .card-wrap {
      width: min(78vw, 19rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-wrap {
      transform: none;
    }
  }
</style>
