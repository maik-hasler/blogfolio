---
import { Image } from 'astro:assets';
import meImage from '../../assets/me.png';
import Mana from '../ui/Mana.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-page hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Software architect · Trainer · IHK examiner</p>
      <h1 id="hero-title">I build software with people in mind.</h1>
      <p class="hero__intro">
        I’m Maik, a software architect at VRG GmbH in Oldenburg. I work on architecture and technical
        strategy, train apprentices, and examine at IHK Oldenburg.
      </p>
      <div class="hero__links">
        <a class="text-link" href="#work">My work <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="/blog">Read the blog <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero__location">Oldenburg, Germany</p>
    </div>

    <figure class="card-wrap">
      <article class="mtg-card" aria-label="Custom Magic card: Maik Hasler">
        <div class="card-border">
          <div class="card-frame">
            <header class="card-title">
              <h2>Maik Hasler</h2>
              <span class="mana-cost" role="img" aria-label="Two generic, one blue, one red mana">
                <Mana sym="2" /><Mana sym="U" /><Mana sym="R" />
              </span>
            </header>

            <div class="card-art">
              <Image src={meImage} alt="Maik Hasler wearing a cap and glasses" width={800} class="art-img" />
            </div>

            <div class="card-type">
              <span>Legendary Creature: Human Advisor</span>
              <span class="set-symbol" role="img" aria-label="Mythic rare">M</span>
            </div>

            <div class="card-rules">
              <p>
                Whenever a teammate asks “why?”, investigate. (Create a Clue token.)
              </p>
              <p>
                At your end step, put a +1/+1 counter on a Human you trained this turn.
              </p>
              <p class="card-flavor">
                “Great software is a team sport.”
              </p>
            </div>

            <footer class="card-footer">
              <span>MH · CUSTOM SET · 001</span>
              <span class="card-pt">2/4</span>
            </footer>
          </div>
        </div>
      </article>
    </figure>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    color: var(--color-cream);
    background: var(--color-night);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .hero__copy {
    max-width: 39rem;
  }
  .eyebrow,
  .hero__location {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.025em;
    color: #d3b970;
  }
  .hero h1 {
    max-width: 13ch;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6.2vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.91;
    color: #f5ecd8;
    text-wrap: balance;
  }
  .hero__intro {
    max-width: 34rem;
    margin-top: 1.8rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: #d7d1dc;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2rem;
  }
  .text-link {
    color: #f5ecd8;
    text-decoration: underline;
    text-decoration-color: #c9a95e;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .text-link:hover {
    color: #e3c36f;
  }
  .hero__location {
    margin-top: 3rem;
    color: #ada2b3;
  }
  .card-wrap {
    width: min(100%, 25rem);
    justify-self: center;
  }

  .mtg-card {
    container-type: inline-size;
    aspect-ratio: 63 / 88;
    padding: 1.4cqw;
    border: 0.65cqw solid #101016;
    border-radius: 2.8cqw;
    background: #403c48;
    box-shadow:
      0 2.8rem 5rem -2rem rgb(0 0 0 / 0.75),
      inset 0 0 0 0.45cqw #b5964e;
  }
  .card-border {
    position: relative;
    height: 100%;
    padding: 1.25cqw;
    overflow: hidden;
    border: 0.45cqw solid #111016;
    border-radius: 1.9cqw;
    background: #292631;
    box-shadow: inset 0 0 0 0.35cqw #9a7941;
  }
  .card-frame {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 1.45cqw;
    padding: 0.75cqw;
  }
  .card-title,
  .card-type {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6cqw;
    border: 0.4cqw solid #50443c;
    border-radius: 1.15cqw;
    background: #e8dfca;
    box-shadow: inset 0 0 0 0.35cqw #f7efd9;
    color: #201c1a;
  }
  .card-title {
    min-height: 8.4cqw;
    padding: 1cqw 2.2cqw;
    font-family: var(--font-sans);
    font-size: 4.6cqw;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .card-title h2 {
    max-width: 70%;
    font-size: inherit;
    line-height: inherit;
  }
  .mana-cost {
    display: flex;
    flex: none;
    align-items: center;
    margin-right: -0.6cqw;
  }
  .card-art {
    position: relative;
    flex: 0 0 42%;
    overflow: hidden;
    border: 0.55cqw solid #17151b;
    outline: 0.3cqw solid #b5964e;
    outline-offset: -0.2cqw;
    background: #35333b;
  }
  .art-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 27%;
    filter: saturate(0.88) contrast(1.06);
  }
  .card-type {
    min-height: 7.4cqw;
    padding: 0.8cqw 2cqw;
    font-family: var(--font-sans);
    font-size: 3.15cqw;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .set-symbol {
    display: grid;
    width: 5.3cqw;
    height: 5.3cqw;
    flex: none;
    place-items: center;
    border: 1px solid #40311e;
    border-radius: 50%;
    background: #c59a3e;
    color: #392918;
    font: 700 2.4cqw var(--font-display);
  }
  .card-rules {
    position: relative;
    flex: 1;
    padding: 2.6cqw 3cqw;
    border: 0.45cqw solid #574c40;
    border-radius: 1cqw;
    background: #f0e7d0;
    box-shadow: inset 0 0 0 0.4cqw #fff7df;
    color: #241e20;
    font-family: var(--font-serif);
    font-size: max(0.875rem, 3.7cqw);
    line-height: 1.19;
  }
  .card-rules p + p {
    margin-top: 1.7cqw;
  }
  .card-flavor {
    margin-top: 2.2cqw !important;
    padding-top: 1.8cqw;
    border-top: 0.3cqw solid rgb(48 39 34 / 0.4);
    font-style: italic;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 7cqw;
    padding-inline: 1.3cqw;
    color: #f1e8d4;
    font: 2.15cqw var(--font-mono);
    letter-spacing: 0.04em;
  }
  .card-pt {
    position: relative;
    margin-block: -5.6cqw -7.5cqw;
    margin-right: 1cqw;
    padding: 0.7cqw 3.1cqw;
    border: 0.5cqw solid #514632;
    border-radius: 1cqw;
    background: #e8dfca;
    color: #211b21;
    font: 700 4.8cqw var(--font-sans);
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 26.5rem;
    }
    .card-wrap { width: 25rem; }
  }
  @media (max-width: 899px) {
    .hero__copy {
      max-width: 44rem;
    }
    .card-wrap {
      width: min(83vw, 24rem);
    }
  }
</style>
