---
import PixelLabel from '../ui/PixelLabel.astro';
import PixelButton from '../ui/PixelButton.astro';
import PistonBlock from '../ui/PistonBlock.astro';
import Arrow from '../ui/Arrow.astro';
---

<section class="blueprint text-cream" aria-labelledby="hero-titel">
  <div class="container-page grid items-center gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
    <div class="max-w-2xl">
      <PixelLabel tone="bright">Steckbrief</PixelLabel>
      <h1 id="hero-titel" class="font-display text-display-xl font-bold uppercase display-shadow mt-4">
        Maik <br />Hasler
      </h1>
      <p class="font-display text-display-md font-bold uppercase display-shadow mt-4 text-cream-muted">
        Ausbilder. Architekt. <span class="text-redstone-bright">Piston.</span>
      </p>
      <p class="mt-6 max-w-xl text-lg text-cream-muted">
        Softwarearchitekt und Ausbilder aus Oldenburg. Für einen meiner Azubis habe ich mich mal als
        Minecraft‑Block beschrieben. Das hier ist die lange Version.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <PixelButton href="/blog">Blog lesen</PixelButton>
        <PixelButton href="https://www.linkedin.com/in/maik-hasler/" tone="paper" external>Kontakt</PixelButton>
      </div>
    </div>

    <div class="relative mx-auto flex w-fit flex-col items-center lg:justify-self-end">
      <Arrow kind="swoosh" class="hero-arrow absolute -left-36 -top-4 hidden w-44 text-cream lg:block" />
      <PistonBlock class="w-44 sm:w-52 lg:w-64" animated />
      <PixelLabel tone="bright" class="mt-6">Piston</PixelLabel>
      <p class="mt-2 font-mono italic text-cream-dim">~ Maik</p>
    </div>
  </div>
</section>

<style>
  /* Der Pfeil zeichnet sich beim Laden einmal selbst. */
  .hero-arrow :global(path) {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: zeichnen 900ms ease-out 300ms forwards;
  }
  .hero-arrow :global(path:last-child) {
    animation-delay: 950ms;
    animation-duration: 250ms;
  }
  @keyframes zeichnen {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-arrow :global(path) {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
