---
import PixelButton from '../ui/PixelButton.astro';
---

<section class="blueprint text-cream" aria-labelledby="contact-title">
  <div class="container-page grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-20">
    <div>
      <p class="font-mono text-label font-semibold uppercase text-redstone-bright">Multiplayer</p>
      <h2 id="contact-title" class="mt-3 font-display text-display-lg font-bold uppercase display-shadow">
        Challenge me to a duel
      </h2>
      <p class="mt-4 max-w-md text-lg text-cream-muted">
        Ideas, feedback, or just want to chat about architecture or Magic. I'd love to hear from you.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <PixelButton href="https://www.linkedin.com/in/maik-hasler/" external>Message me</PixelButton>
        <PixelButton href="https://github.com/maik-hasler" tone="paper" external>GitHub</PixelButton>
      </div>
    </div>

    <div class="mx-auto flex flex-col items-center gap-4 text-center">
      <button type="button" id="coin" class="coin" aria-label="Flip a coin to see how fast I reply">
        <span id="coin-face">?</span>
      </button>
      <p class="min-h-[3rem] max-w-xs font-serif text-lg italic text-cream-muted" id="coin-text" role="status" aria-live="polite">
        Flip the coin to find out how fast I reply.
      </p>
    </div>
  </div>
</section>

<style>
  .coin {
    display: grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    border: 4px solid var(--color-gold-deep);
    background: radial-gradient(circle at 30% 30%, #fbe39a, var(--color-gold) 55%, var(--color-gold-deep));
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.7);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.5rem;
    color: var(--color-ink);
    cursor: pointer;
  }
  .coin:hover {
    filter: brightness(1.08);
  }
</style>

<script>
  const coin = document.getElementById('coin') as HTMLButtonElement;
  const face = document.getElementById('coin-face')!;
  const text = document.getElementById('coin-text')!;
  const results = [
    ['H', 'Heads: I reply today.'],
    ['T', 'Tails: I reply today, but with a diagram.'],
  ];
  coin.addEventListener('click', () => {
    const [f, t] = results[Math.random() < 0.5 ? 0 : 1];
    coin.animate([{ transform: 'rotateY(0)' }, { transform: 'rotateY(1080deg)' }], { duration: 700, easing: 'ease-out' });
    setTimeout(() => {
      face.textContent = f;
      text.textContent = t;
    }, 350);
  });
</script>
