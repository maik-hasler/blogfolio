---
---

<section class="contact" aria-labelledby="contact-title">
  <div class="container-page contact__inner">
    <div>
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title">Have a good question?</h2>
    </div>
    <div class="contact__copy">
      <p>
        I’m always glad to talk about software architecture, mentoring, or a project that could use
        another pair of eyes.
      </p>
      <a class="contact__link" href="https://www.linkedin.com/in/maik-hasler/" target="_blank" rel="noopener noreferrer">
        Find me on LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--color-paper-alt);
  }
  .contact__inner {
    display: grid;
    gap: 2rem 5rem;
  }
  .contact h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .contact__copy {
    max-width: 33rem;
    color: var(--color-muted);
  }
  .contact__link {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .contact__link:hover {
    color: var(--color-accent);
  }
  @media (min-width: 760px) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }
</style>
