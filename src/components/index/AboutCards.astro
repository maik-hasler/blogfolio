---
import Mana from '../ui/Mana.astro';

/**
 * The backstory as three spell cards. Each card is a real <article>, and
 * hovering lifts it. Frame styles live in global.css (.mtg-card).
 */
const cards = [
  {
    id: 'origin',
    name: 'Origin Story',
    cost: ['1', 'U'],
    type: 'Sorcery — Lore',
    tone: 'blue',
    paragraphs: [
      'Finished school right in the middle of the pandemic. Officially: Abitur with a focus on health and care. Unofficially: full-time gaming, thanks to homeschooling. That’s exactly when I slid into programming. My motivation: why farm something for hours when a script can just do it for me?',
      'In 2021 I started an apprenticeship as a software developer. Today I’m a <strong>software architect</strong> and <strong>trainer</strong>, and an <strong>IHK examiner</strong> on the side.',
    ],
    flavor: 'Gaming was never a waste of time. It was research.',
  },
  {
    id: 'side-quests',
    name: 'Side Quests',
    cost: ['2', 'G'],
    type: 'Enchantment — Hobbies',
    tone: 'green',
    paragraphs: [
      'Honestly, I often build more in my free time than at work. My biggest project right now is <a href="https://github.com/maik-hasler/einsatzbereit">Einsatzbereit</a>, an attempt at building a regional platform for volunteer work.',
      'Otherwise: Path of Exile 2, board and card games (Magic: The Gathering especially), running for the Oldenburg Marathon (not going well), and tech books and podcasts. I love eating, but hate cooking.',
    ],
    flavor: 'Whenever Maik is not coding, he is probably still gaming.',
  },
  {
    id: 'why',
    name: 'Binary Mind',
    cost: ['R', 'R'],
    type: 'Instant — Personality',
    tone: 'red',
    paragraphs: [
      'With me, it’s binary. 0 or 1. Either I’m completely obsessed with something and forget to eat, sleep, or talk to another human being, or I’m the exact opposite and do nothing at all.',
      'There’s rarely an in-between. Mostly it’s just the transition from one extreme to the other.',
    ],
    flavor: 'Yes, that is why his power is 0.',
  },
] as const;
---

<section class="container-page py-16 lg:py-24" aria-labelledby="about-title" id="about">
  <div class="mb-10 max-w-2xl">
    <p class="font-mono text-label font-semibold uppercase text-redstone">The rest of the deck</p>
    <h2 id="about-title" class="mt-3 font-display text-display-lg font-bold uppercase">Three more cards</h2>
    <p class="mt-3 text-ink-soft">What the text box on the front couldn’t hold.</p>
  </div>

  <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
    {cards.map((card) => (
      <article class="spell mtg-card" data-tone={card.tone} id={card.id}>
        <div class="mtg-frame">
          <div class="mtg-bar">
            <h3>{card.name}</h3>
            <span class="whitespace-nowrap">{card.cost.map((sym) => <Mana sym={sym} />)}</span>
          </div>
          <div class="mtg-bar mtg-type"><span>{card.type}</span></div>
          <div class="mtg-text spell-text">
            {card.paragraphs.map((p) => <p set:html={p} />)}
            <p class="mtg-flavor">{card.flavor}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .spell {
    aspect-ratio: auto;
    min-height: 0;
    transition: transform 200ms ease-out, box-shadow 200ms;
  }
  .spell:hover {
    transform: translateY(-6px) rotate(-0.6deg);
    box-shadow: 0 4cqw 8cqw -2cqw rgb(0 0 0 / 0.75);
  }
  .spell[data-tone='blue'] .mtg-frame {
    background: linear-gradient(155deg, #1f3a7a, #4b6cc1);
  }
  .spell[data-tone='green'] .mtg-frame {
    background: linear-gradient(155deg, #1f5a35, #5a9a4a);
  }
  .spell[data-tone='red'] .mtg-frame {
    background: linear-gradient(155deg, #7a1f2b, #c2543c);
  }
  .spell-text {
    flex: 1;
    font-size: 5.1cqw;
    line-height: 1.3;
    padding: 4cqw;
    overflow: visible;
  }
  .spell-text :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-gold-deep);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .spell-text :global(a:hover) {
    color: var(--color-redstone);
  }
  @media (prefers-reduced-motion: reduce) {
    .spell:hover {
      transform: none;
    }
  }
</style>
