---
import PostCard from '../PostCard.astro';
import { getPublishedPosts, postUrl } from '../../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
---

<section class="writing" aria-labelledby="blog-title">
  <div class="container-page writing__inner">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Field notes</p>
      <h2 id="blog-title" class="mt-3 font-display text-display-lg font-medium">Recent notes</h2>
      <p class="mt-3 max-w-xl text-ink-soft">Things I’ve learned about software, architecture, and working with people.</p>
    </div>
    <a class="text-link" href="/blog">All posts <span aria-hidden="true">↗</span></a>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <PostCard
        url={postUrl(post)}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        readingMinutes={post.data.ttr}
      />
    ))}
  </div>
  </div>
</section>

<style>
  .writing {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--color-night);
    color: var(--color-cream);
    --color-ink: var(--color-cream);
    --color-ink-soft: #c9c1cf;
    --color-accent: #d8bd72;
    --color-line: rgb(236 223 194 / 0.23);
  }
  .writing__inner {
    position: relative;
    z-index: 1;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #d8bd72;
  }
  h2 {
    letter-spacing: -0.04em;
  }
  .writing .text-ink-soft {
    color: var(--color-ink-soft);
  }
  .text-link {
    color: var(--color-cream);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .text-link:hover {
    color: #ead89d;
  }
  @media (max-width: 640px) {
    .writing__inner > div:first-child {
      align-items: flex-start;
    }
  }
</style>
