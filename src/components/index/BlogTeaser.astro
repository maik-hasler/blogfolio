---
import PostCard from '../PostCard.astro';
import { getPublishedPosts, postUrl } from '../../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
---

<section class="container-page py-16 lg:py-24" aria-labelledby="blog-title">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Writing</p>
      <h2 id="blog-title" class="mt-3 font-display text-display-lg font-medium">Recent notes</h2>
      <p class="mt-3 max-w-xl text-ink-soft">Things I’ve learned about software, architecture, and working with people.</p>
    </div>
    <a class="text-link" href="/blog">All posts <span aria-hidden="true">↗</span></a>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <PostCard
        url={postUrl(post)}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        readingMinutes={post.data.ttr}
      />
    ))}
  </div>
</section>

<style>
  section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  h2 {
    letter-spacing: -0.04em;
  }
  .text-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .text-link:hover {
    color: var(--color-accent);
  }
</style>
