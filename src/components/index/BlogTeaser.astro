---
import { getCollection } from 'astro:content';
import PixelLabel from '../ui/PixelLabel.astro';
import PixelButton from '../ui/PixelButton.astro';
import PostCard from '../PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="container-page py-16 lg:py-24" aria-labelledby="blog-titel">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <PixelLabel as="h2"><span id="blog-titel">Buch &amp; Feder</span></PixelLabel>
      <p class="mt-4 max-w-xl text-ink-soft">
        Was ich unterwegs lerne, schreibe ich auf. Auf Englisch, damit auch der Rest der Welt mitlesen kann.
      </p>
    </div>
    <PixelButton href="/blog" tone="paper">Alle Beiträge</PixelButton>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <PostCard
        url={`/blog/${post.id}/`}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        ttr={post.data.ttr}
      />
    ))}
  </div>
</section>
