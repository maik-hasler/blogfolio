---
import { Icon } from 'astro-icon/components';
import { getPublishedPosts, postUrl } from '../lib/posts';

/** Search across posts. Only the title, summary, tags, and URL ship in the page. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const posts = (await getPublishedPosts()).map((post) => ({
  url: postUrl(post),
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
}));
---

<button
  id="search-open"
  type="button"
  class:list={['flex items-center gap-2 px-3 py-3 text-sm', className]}
  aria-haspopup="dialog"
  aria-controls="search-dialog"
>
  <Icon name="mdi:magnify" class="size-5" aria-hidden="true" />
  <span class="sr-only sm:not-sr-only">Search</span>
  <kbd aria-hidden="true" class="hidden md:inline border border-current px-1.5 py-0.5 text-[0.65rem] normal-case tracking-normal opacity-70">/</kbd>
</button>

<dialog
  id="search-dialog"
  class="search-dialog m-auto w-[min(100%-2rem,40rem)] rounded-md border border-line bg-paper-light p-0 text-ink shadow-card backdrop:bg-ink/35"
  aria-label="Search posts"
>
  <form method="dialog" class="flex items-center gap-3 border-b border-line px-4 py-3">
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      placeholder="Search posts by title, topic, or tag"
      aria-label="Search query"
      aria-describedby="search-status"
      class="min-w-0 grow bg-transparent placeholder:text-ink-soft focus:outline-none"
    />
    <button type="submit" class="-mr-2 shrink-0 whitespace-nowrap px-3 py-2 text-sm text-ink-soft hover:text-ink">
      Close<span class="sr-only"> search</span>
    </button>
  </form>
  <p id="search-status" class="sr-only" aria-live="polite"></p>
  <ul id="search-results" class="max-h-[60vh] overflow-y-auto p-2" role="list" aria-label="Results"></ul>
</dialog>

<style>
  .search-dialog::backdrop {
    backdrop-filter: blur(2px);
  }
</style>

<script is:inline type="module" define:vars={{ posts }}>
  const dialog = document.getElementById('search-dialog');
  const openButton = document.getElementById('search-open');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const status = document.getElementById('search-status');

  const escapeHtml = (text) =>
    text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  function search(query) {
    const q = query.trim().toLowerCase();
    if (!q) return posts;
    return posts.filter(
      (post) =>
        post.title.toLowerCase().includes(q) ||
        post.description.toLowerCase().includes(q) ||
        post.tags.some((tag) => tag.toLowerCase().includes(q)),
    );
  }

  function render(query) {
    const hits = search(query);
    status.textContent = hits.length ? `${hits.length} results, press Enter to open the first` : 'No results';
    if (hits.length === 0) {
      results.innerHTML = `<li class="px-3 py-4 text-sm text-ink-soft">No posts match that search.</li>`;
      return;
    }
    results.innerHTML = hits
      .map(
        (post) => `
        <li>
          <a href="${post.url}" class="block rounded px-3 py-3 hover:bg-paper-dark focus-visible:bg-paper-dark">
            <span class="block font-semibold text-ink">${escapeHtml(post.title)}</span>
            <span class="block text-sm text-ink-soft">${escapeHtml(post.description)}</span>
          </a>
        </li>`,
      )
      .join('');
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.value = '';
    render('');
    input.focus();
  }

  const isEditable = (element) =>
    element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement || element?.isContentEditable;

  openButton.addEventListener('click', open);
  input.addEventListener('input', () => render(input.value));
  input.addEventListener('keydown', (event) => {
    // Enter opens the first hit, but only for an actual query.
    if (event.key !== 'Enter' || !input.value.trim()) return;
    event.preventDefault();
    const first = results.querySelector('a');
    if (first) window.location.assign(first.href);
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.addEventListener('keydown', (event) => {
    const ctrlK = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
    const slash = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey && !isEditable(document.activeElement);
    if (ctrlK || slash) {
      event.preventDefault();
      open();
    }
  });
</script>
