---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

/**
 * Suche über alle Beiträge, gestaltet wie ein Chat-Befehl ("/suche").
 * Es wird nur ein schlanker Index (Titel, Beschreibung, Tags) ins HTML geschrieben.
 */
interface Props {
  tone?: 'dark' | 'paper';
}
const { tone = 'paper' } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => data.published)).map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
}));

const buttonTone =
  tone === 'dark'
    ? 'hover:bg-ink hover:text-redstone-bright'
    : 'hover:bg-paper-dark hover:text-redstone';
---

<div id="suche">
  <button
    id="suche-oeffnen"
    type="button"
    class:list={['flex items-center gap-2 px-3 py-2 font-mono text-label font-semibold uppercase', buttonTone]}
    aria-haspopup="dialog"
    aria-controls="suche-dialog"
  >
    <Icon name="mdi:magnify" class="size-5" />
    <span class="hidden sm:inline">Suche</span>
    <kbd class="hidden md:inline border border-current px-1.5 py-0.5 text-[0.65rem] normal-case tracking-normal opacity-70">/</kbd>
  </button>

  <dialog
    id="suche-dialog"
    class="m-auto w-[min(100%-2rem,40rem)] border-2 border-stone-light bg-ink p-0 text-cream shadow-pixel backdrop:bg-ink/70"
    aria-label="Beiträge durchsuchen"
  >
    <form method="dialog" class="flex items-center gap-3 border-b-2 border-stone px-4 py-3 font-mono">
      <span class="text-redstone-bright font-semibold select-none" aria-hidden="true">/suche</span>
      <input
        id="suche-eingabe"
        type="search"
        autocomplete="off"
        placeholder="Titel, Beschreibung oder Tag …"
        aria-label="Suchbegriff"
        class="min-w-0 grow bg-transparent text-cream placeholder:text-cream-dim focus:outline-none"
      />
      <button type="submit" class="font-mono text-xs uppercase text-cream-dim hover:text-cream" aria-label="Suche schließen">Esc</button>
    </form>
    <ul id="suche-treffer" class="max-h-[60vh] overflow-y-auto p-2" role="list" aria-label="Treffer"></ul>
  </dialog>
</div>

<script is:inline type="module" define:vars={{ posts }}>
  const dialog = document.getElementById('suche-dialog');
  const oeffnen = document.getElementById('suche-oeffnen');
  const eingabe = document.getElementById('suche-eingabe');
  const treffer = document.getElementById('suche-treffer');

  const escapeHtml = (text) =>
    text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  function suchen(query) {
    const q = query.trim().toLowerCase();
    if (!q) return posts;
    return posts.filter(
      (post) =>
        post.title.toLowerCase().includes(q) ||
        post.description.toLowerCase().includes(q) ||
        post.tags.some((tag) => tag.toLowerCase().includes(q)),
    );
  }

  function render(query) {
    const ergebnisse = suchen(query);
    if (ergebnisse.length === 0) {
      treffer.innerHTML = `<li class="px-3 py-4 font-mono text-sm text-cream-dim">Unbekannter Befehl. Versuch's mit <span class="text-redstone-bright">/suche plantuml</span></li>`;
      return;
    }
    treffer.innerHTML = ergebnisse
      .map(
        (post) => `
        <li>
          <a href="/blog/${encodeURIComponent(post.id)}/" lang="en" class="block px-3 py-3 hover:bg-stone focus-visible:bg-stone">
            <span class="block font-semibold text-cream">${escapeHtml(post.title)}</span>
            <span class="block text-sm text-cream-dim">${escapeHtml(post.description)}</span>
          </a>
        </li>`,
      )
      .join('');
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    eingabe.value = '';
    render('');
    eingabe.focus();
  }

  oeffnen.addEventListener('click', open);
  eingabe.addEventListener('input', () => render(eingabe.value));
  eingabe.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    const erster = treffer.querySelector('a');
    if (erster) window.location.assign(erster.href);
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  const inEingabefeld = (element) =>
    element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement || element?.isContentEditable;

  document.addEventListener('keydown', (event) => {
    const strgK = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
    const slash = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey && !inEingabefeld(document.activeElement);
    if (strgK || slash) {
      event.preventDefault();
      open();
    }
  });
</script>
