---
/** Tags as small mono chips, on cards and in the article header. */
interface Props {
  tags: string[];
  class?: string;
}
const { tags, class: className = '' } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-x-2 gap-y-1 text-sm text-ink-soft', className]} role="list" aria-label="Tags">
  {tags.map((tag) => (
    <li>{tag}</li>
  ))}
</ul>

<style>
  li + li::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--color-accent);
  }
</style>
