---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PixelLabel from './PixelLabel.astro';

/** Das Polaroid mit "TEXTURE PACK"-Label und Bildunterschrift in Plex Mono. */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  label?: string;
  rotate?: number;
  class?: string;
}
const { src, alt, caption, label, rotate = 0, class: className = '' } = Astro.props;
---

<figure class:list={['polaroid relative inline-block', className]} style={`--rotate: ${rotate}deg`}>
  {label && (
    <div class="absolute -top-5 -left-3 z-10 rotate-[-3deg]">
      <PixelLabel as="span">{label}</PixelLabel>
    </div>
  )}
  <div class="bg-paper-light border-2 border-stone p-3 pb-4 shadow-card">
    <div class="border-2 border-dashed border-oak p-1 bg-paper-tan">
      <Image src={src} alt={alt} width={480} height={480} loading="eager" class="grayscale w-full aspect-square object-cover" />
    </div>
    <figcaption class="mt-4 text-center font-mono italic text-sm text-ink-soft">{caption}</figcaption>
  </div>
</figure>

<style>
  .polaroid {
    transform: rotate(var(--rotate));
    max-width: 22rem;
  }
</style>
