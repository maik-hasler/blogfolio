---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  preloadItalic?: boolean;
}

const { title, description, type = 'website', publishedTime, preloadItalic = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#3a3a34" />

<link rel="icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />

<link rel="manifest" href="/manifest.json" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Maik Hasler – Blog" href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org/",
  "@type": "Person",
  "name": "Maik Hasler",
  "url": "https://maik-hasler.de/",
  "image": "https://maik-hasler.de/favicon-192x192.png",
  "sameAs": [
    "https://www.linkedin.com/in/maik-hasler/",
    "https://github.com/maik-hasler"
  ],
  "jobTitle": "Software Architect",
  "address": { "@type": "PostalAddress", "addressLocality": "Oldenburg", "addressCountry": "DE" }
}
</script>

<link rel="preload" href="/fonts/pixelify-sans-400-700-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-400-700-normal.woff2" as="font" type="font/woff2" crossorigin />
{preloadItalic && <link rel="preload" href="/fonts/inter-400-700-italic.woff2" as="font" type="font/woff2" crossorigin />}
<link rel="preload" href="/fonts/ibm-plex-mono-600-normal.woff2" as="font" type="font/woff2" crossorigin />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Maik Hasler" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Player card: Maik Hasler as a piston block, pixel art" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
