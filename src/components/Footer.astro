---
import { Icon } from 'astro-icon/components';
import { getPublishedPosts } from '../lib/posts';

const navigation = [
  { url: '/', label: 'Home' },
  { url: '/blog', label: 'Blog' },
];

const resources = [
  { url: '/rss.xml', label: 'RSS Feed' },
  { url: '/sitemap-index.xml', label: 'Sitemap' },
  { url: 'https://github.com/maik-hasler/blogfolio', label: 'Source Code' },
];

const contact = [
  { url: 'https://github.com/maik-hasler', icon: 'mdi:github', label: 'GitHub' },
  { url: 'https://www.linkedin.com/in/maik-hasler/', icon: 'mdi:linkedin', label: 'LinkedIn' },
];

/* The end year tracks the newest post, not build time. */
const [latest] = await getPublishedPosts();
const copyrightYear = Math.max(new Date().getFullYear(), latest?.data.pubDate.getFullYear() ?? 0);
---

<footer class="site-footer">
  <div class="container-page site-footer__inner">
    <a class="site-footer__name" href="/">Maik Hasler<span>.</span></a>
    <nav aria-label="Footer navigation">
      {navigation.map((item) => <a href={item.url}>{item.label}</a>)}
      {resources.map((item) => <a href={item.url}>{item.label}</a>)}
      {contact.map((item) => (
        <a href={item.url} target="_blank" rel="noopener noreferrer">
          <Icon name={item.icon} class="size-4" aria-hidden="true" />
          {item.label}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      ))}
    </nav>
    <p>© {copyrightYear} Maik Hasler · Oldenburg, Germany</p>
    <p class="site-footer__disclaimer">
      Magic: The Gathering is a trademark of Wizards of the Coast. This personal fan tribute is not
      affiliated with or endorsed by them.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
    background: var(--color-footer);
    color: #e8e5dc;
  }
  .site-footer__inner {
    display: grid;
    gap: 1.25rem;
  }
  .site-footer__name {
    width: fit-content;
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .site-footer__name span {
    color: var(--color-accent-soft);
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    font-size: 0.88rem;
  }
  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .site-footer a:hover {
    color: var(--color-accent-soft);
  }
  .site-footer__inner > p {
    font-size: 0.8rem;
    color: #c1c0b9;
  }
  .site-footer__disclaimer {
    max-width: 44rem;
  }
</style>
