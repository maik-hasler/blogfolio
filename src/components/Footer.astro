---
import { Icon } from 'astro-icon/components';
import PixelLabel from './ui/PixelLabel.astro';
import { getPublishedPosts } from '../lib/posts';

const navigation = [
  { url: '/', label: 'Home' },
  { url: '/blog', label: 'Blog' },
];

const resources = [
  { url: '/rss.xml', label: 'RSS Feed' },
  { url: '/sitemap-index.xml', label: 'Sitemap' },
  { url: 'https://github.com/maik-hasler/blogfolio', label: 'Source Code' },
];

const contact = [
  { url: 'https://github.com/maik-hasler', icon: 'mdi:github', label: 'GitHub' },
  { url: 'https://www.linkedin.com/in/maik-hasler/', icon: 'mdi:linkedin', label: 'LinkedIn' },
];

/* The end year tracks the newest post, not build time. */
const [latest] = await getPublishedPosts();
const lastYear = Math.max(2025, latest?.data.pubDate.getFullYear() ?? 2025);
const copyright = lastYear > 2025 ? `2025–${lastYear}` : '2025';
---

<footer class="bg-ink text-cream-muted">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div class="max-w-md">
      <PixelLabel tone="bright">End of the Chunk</PixelLabel>
      <p class="font-display text-display-md font-bold uppercase display-shadow text-cream mt-4">Still here?</p>
      <p class="mt-3">
        You've scrolled all the way down. Either you like the site, or you scrolled past the end by
        accident. Both are fine. Let me know what you think.
      </p>
    </div>

    <nav aria-label="Footer navigation" class="flex flex-col gap-3">
      <h2 class="font-mono text-label font-semibold uppercase text-cream-dim">Navigation</h2>
      {navigation.map((item) => (
        <a href={item.url} class="w-fit hover:text-redstone-bright">{item.label}</a>
      ))}
    </nav>

    <div class="flex flex-col gap-3">
      <h2 class="font-mono text-label font-semibold uppercase text-cream-dim">Resources</h2>
      {resources.map((item) => (
        <a href={item.url} class="w-fit hover:text-redstone-bright">{item.label}</a>
      ))}
    </div>

    <div class="flex flex-col gap-3">
      <h2 class="font-mono text-label font-semibold uppercase text-cream-dim">Contact</h2>
      {contact.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-fit items-center gap-2 hover:text-redstone-bright"
        >
          <Icon name={item.icon} class="size-5" aria-hidden="true" />
          {item.label}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      ))}
    </div>
  </div>

  <div class="container-page flex flex-col gap-2 border-t border-stone py-5 font-mono text-xs text-cream-dim">
    <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-between sm:gap-x-8">
      <span>Y = −64 · Bedrock. Nothing lower. <span class="whitespace-nowrap">© {copyright} Maik&nbsp;Hasler</span></span>
      <span>Built with Astro, hosted on Hetzner. <span class="whitespace-nowrap">~&nbsp;Maik</span></span>
    </div>
    <p>Not an official Minecraft product. Not approved by or associated with Mojang.</p>
  </div>
  <div class="bedrock h-4" aria-hidden="true"></div>
</footer>
