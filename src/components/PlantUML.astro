---
import plantumlEncoder from 'plantuml-encoder';

/**
 * Renders a PlantUML diagram via the public PlantUML server. The source
 * lives in src/assets/diagrams; a missing filename fails the build instead
 * of shipping a broken image. `width`/`height` prevent layout shifts.
 */
interface Props {
  file: string;
  alt: string;
  width?: number;
  height?: number;
}

const diagrams = import.meta.glob('../assets/diagrams/*.puml', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

const { file, alt, width, height } = Astro.props;
const source = diagrams[`../assets/diagrams/${file}`];
if (!source) {
  throw new Error(`PlantUML: "${file}" is missing from src/assets/diagrams. Available: ${Object.keys(diagrams).map((key) => key.split('/').pop()).join(', ')}`);
}

const imageUrl = `https://www.plantuml.com/plantuml/svg/${plantumlEncoder.encode(source)}`;
---

<img
  src={imageUrl}
  alt={alt}
  width={width}
  height={height}
  loading="lazy"
  decoding="async"
  class="mx-auto my-4 h-auto"
  style={width && height ? `aspect-ratio: ${width} / ${height}` : undefined}
/>
