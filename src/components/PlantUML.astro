---
import plantumlEncoder from 'plantuml-encoder';

/**
 * Rendert ein PlantUML-Diagramm über den öffentlichen PlantUML-Server.
 * Die Quelle liegt in src/assets/diagrams; ein fehlender Dateiname bricht den Build,
 * statt ein kaputtes Bild auszuliefern. `width`/`height` verhindern Layout-Sprünge.
 */
interface Props {
  file: string;
  alt: string;
  width?: number;
  height?: number;
}

const diagrams = import.meta.glob('../assets/diagrams/*.puml', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

const { file, alt, width, height } = Astro.props;
const source = diagrams[`../assets/diagrams/${file}`];
if (!source) {
  throw new Error(`PlantUML: "${file}" fehlt in src/assets/diagrams. Vorhanden: ${Object.keys(diagrams).map((key) => key.split('/').pop()).join(', ')}`);
}

const imageUrl = `https://www.plantuml.com/plantuml/svg/${plantumlEncoder.encode(source)}`;
---

<img
  src={imageUrl}
  alt={alt}
  width={width}
  height={height}
  loading="lazy"
  decoding="async"
  class="mx-auto my-4 h-auto"
  style={width && height ? `aspect-ratio: ${width} / ${height}` : undefined}
/>
