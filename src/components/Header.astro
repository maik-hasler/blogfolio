---
import { Icon } from 'astro-icon/components';
import PistonBlock from './ui/PistonBlock.astro';
import Searchbar from './Searchbar.astro';

interface Props {
  tone?: 'dark' | 'paper';
}
const { tone = 'paper' } = Astro.props;

const tones = {
  dark: 'bg-stone/95 text-cream border-ink',
  paper: 'bg-paper/95 text-ink border-stone',
};
const linkHover =
  tone === 'dark'
    ? 'hover:bg-ink hover:text-redstone-bright'
    : 'hover:bg-paper-dark hover:text-redstone';

const socials = [
  { url: 'https://github.com/maik-hasler', icon: 'mdi:github', label: 'GitHub' },
  { url: 'https://www.linkedin.com/in/maik-hasler/', icon: 'mdi:linkedin', label: 'LinkedIn' },
];
---

<header data-tone={tone} class:list={['sticky top-0 z-40 border-b-2 backdrop-blur', tones[tone]]}>
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <PistonBlock class="w-7" decorative shadow="sm" />
      <span class="whitespace-nowrap font-display text-lg font-bold uppercase leading-none tracking-wider sm:text-xl">Maik Hasler</span>
      <span class="sr-only">, home</span>
    </a>

    <nav aria-label="Main navigation" class="flex items-center gap-1 sm:gap-2">
      <a href="/blog" class:list={['whitespace-nowrap px-3 py-3 font-mono text-label font-semibold uppercase', linkHover]}>
        Blog
      </a>
      <Searchbar class={linkHover} />
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${social.label} (opens in a new tab)`}
          class:list={['hidden p-2.5 sm:block', linkHover]}
        >
          <Icon name={social.icon} class="size-6" aria-hidden="true" />
        </a>
      ))}
    </nav>
  </div>
</header>
