---
import { Icon } from 'astro-icon/components';
import Searchbar from './Searchbar.astro';

const linkHover = 'hover:text-accent';

const socials = [
  { url: 'https://github.com/maik-hasler', icon: 'mdi:github', label: 'GitHub' },
  { url: 'https://www.linkedin.com/in/maik-hasler/', icon: 'mdi:linkedin', label: 'LinkedIn' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-page/95 text-ink backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <span class="font-display text-xl font-medium leading-none tracking-tight sm:text-2xl">Maik Hasler<span class="text-accent">.</span></span>
      <span class="sr-only">, home</span>
    </a>

    <nav aria-label="Main navigation" class="flex items-center gap-1 sm:gap-2">
      <a href="/blog" class:list={['whitespace-nowrap px-3 py-3 text-sm', linkHover]}>
        Blog
      </a>
      <Searchbar class={linkHover} />
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${social.label} (opens in a new tab)`}
          class:list={['hidden p-2.5 sm:block', linkHover]}
        >
          <Icon name={social.icon} class="size-6" aria-hidden="true" />
        </a>
      ))}
    </nav>
  </div>
</header>
