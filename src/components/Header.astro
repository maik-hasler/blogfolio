---
import { Icon } from 'astro-icon/components';
import PistonBlock from './ui/PistonBlock.astro';
import Searchbar from './Searchbar.astro';

interface Props {
  tone?: 'dark' | 'paper';
}
const { tone = 'paper' } = Astro.props;

const tones = {
  dark: 'bg-stone/95 text-cream border-ink',
  paper: 'bg-paper/95 text-ink border-stone',
};
const iconLink =
  tone === 'dark'
    ? 'hover:bg-ink hover:text-redstone-bright'
    : 'hover:bg-paper-dark hover:text-redstone';
---

<header class:list={['sticky top-0 z-40 border-b-2 backdrop-blur', tones[tone]]}>
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label="Zur Startseite">
      <PistonBlock class="w-7" decorative />
      <span class="whitespace-nowrap font-display text-lg font-bold leading-none tracking-wide sm:text-xl">Maik Hasler</span>
    </a>

    <nav aria-label="Hauptnavigation" class="flex items-center gap-1 sm:gap-2">
      <a
        href="/blog"
        class:list={['whitespace-nowrap px-3 py-2 font-mono text-label font-semibold uppercase', iconLink]}
      >
        Blog
      </a>
      <Searchbar tone={tone} />
      <a
        href="https://github.com/maik-hasler"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class:list={['p-2', iconLink]}
      >
        <Icon name="mdi:github" class="size-6" />
      </a>
      <a
        href="https://www.linkedin.com/in/maik-hasler/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class:list={['p-2', iconLink]}
      >
        <Icon name="mdi:linkedin" class="size-6" />
      </a>
    </nav>
  </div>
</header>
