---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/**
 * Seitengerüst: Kopf, Skip-Link, Hauptbereich, Fuß.
 * `headerTone="dark"` legt den Header auf das dunkle Kopfband der Startseite.
 * Der Slot `head` nimmt seitenspezifische Metadaten auf (z. B. JSON-LD eines Artikels).
 */
interface Props {
  title: string;
  description: string;
  headerTone?: 'dark' | 'paper';
  /** Open-Graph-Typ; Artikel bekommen zusätzlich `article:published_time`. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Sprache des Hauptinhalts (das Drumherum bleibt Deutsch). */
  lang?: 'de' | 'en';
  /** Die Startseite braucht Inter Italic sofort (Notizkarten), andere Seiten nicht. */
  preloadItalic?: boolean;
}

const { title, description, headerTone = 'paper', type = 'website', publishedTime, lang = 'de', preloadItalic = false } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead title={title} description={description} type={type} publishedTime={publishedTime} lang={lang} preloadItalic={preloadItalic} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only-focusable z-50 bg-redstone px-4 py-2 font-mono text-label font-semibold uppercase text-paper-light">
      Zum Inhalt springen
    </a>
    <Header tone={headerTone} />
    <main id="main" class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
